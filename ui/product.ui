  <property name="windowTitle">
   <string>Tentacion - Управление товарами</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #0a0a0f;
    border: none;
}

/* Стили для карточек товаров */
QFrame[objectName="product_card"] {
    background: #1d1d1f;
    border-radius: 20px 20px 12px 12px;
    border: 1px solid #2c2c2e;
    padding: 0px;
}
QFrame[objectName="product_card"]:hover {
    border: 1px solid #007aff;
    background: #2c2c2e;
}

/* Стили для размытых карточек товаров */
QFrame[objectName="product_card_blurred"] {
    background: #1d1d1f;
    border-radius: 20px 20px 12px 12px;
    border: 1px solid #2c2c2e;
    padding: 0px;
    opacity: 0.5;
}

/* Стили для изображений товаров */
QFrame[objectName="product_image"] {
    border-radius: 16px;
    background: #000000;
    border: 1px solid #2c2c2e;
}
QFrame[objectName="product_image"]:hover {
    border: 1px solid #007aff;
}

/* Стили для заголовков товаров */
QLabel[objectName="product_title"] {
    font: bold 18px 'SF Pro Display', 'Segoe UI', sans-serif; 
    color: #f5f5f7; 
    border: none;
    margin-bottom: 8px;
    background: transparent;
}

/* Стили для кнопок покупки */
QPushButton[objectName="buy_button"] {
    background: #007aff;
    color: #ffffff;
    font: bold 14px 'SF Pro Display', 'Segoe UI', sans-serif;
    border-radius: 20px;
    padding: 10px 24px;
    min-width: 120px;
    border: none;
}
QPushButton[objectName="buy_button"]:hover {
    background: #0051d5;
    color: #ffffff;
    border: none;
}
QPushButton[objectName="buy_button"]:pressed {
    background: #0040a8;
    color: #ffffff;
    border: none;
}

/* Стили для цен */
QLabel[objectName="product_price"] {
    font: bold 20px 'SF Pro Display', 'Segoe UI', sans-serif; 
    color: #007aff;
    margin-top: 4px;
    background: transparent;
    border: none;
}</string>
  </property>
