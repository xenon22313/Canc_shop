     <string notr="true">QHeaderView::section {
    background-color: #333;     /* Цвет фона */
    color: white;              /* Цвет текста */
    padding: 5px;              /* Отступы */
    border: 1px solid #555;    /* Границы */
}

/* Фон всей таблицы и цвет сетки */
QTableWidget {
    background-color: rgb(49, 54, 63);
    gridline-color: rgb(80, 80, 80); /* Цвет линий сетки */
}

/* Стиль для текста в ячейках */
QTableWidget QTableCornerButton::section,
QTableWidget::item {
    color: rgb(255, 255, 255); /* Белый текст */
    background-color: transparent; /* Прозрачный фон (или свой цвет) */
}

/* Дополнительно: стиль для выделенных ячеек */
QTableWidget::item:selected {
    background-color: rgb(75, 110, 175); /* Синий при выделении */
    color: white;
}</string>
